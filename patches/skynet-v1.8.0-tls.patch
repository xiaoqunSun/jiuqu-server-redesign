+static bool
+_is_ipv4_literal(const char* host) {
+    bool has_dot = false;
+    if(!host || !*host) return false;
+    for(const char* p = host; *p; ++p) {
+        if(*p == '.') {
+            has_dot = true;
+        } else if(*p < '0' || *p > '9') {
+            return false;
+        }
+    }
+    return has_dot;
+}
+
+static int
+_lctx_verify_peer(lua_State* L) {
+    struct ssl_ctx* ctx_p = _check_sslctx(L, 1);
+    if(SSL_CTX_set_default_verify_paths(ctx_p->ctx) != 1) {
+        luaL_error(L, "SSL_CTX_set_default_verify_paths failed");
+    }
+    if(SSL_CTX_set_min_proto_version(ctx_p->ctx, TLS1_2_VERSION) != 1) {
+        luaL_error(L, "SSL_CTX_set_min_proto_version failed");
+    }
+    SSL_CTX_set_verify(ctx_p->ctx, SSL_VERIFY_PEER, NULL);
+    return 0;
+}
+
